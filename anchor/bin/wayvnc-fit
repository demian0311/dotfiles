#!/usr/bin/env bash
# A permanent virtual screen for the VNC viewer on :5900, the size of the
# Mac's window, so nothing has to be panned.
#   wayvnc-fit ensure   create it if missing (wayvnc.service runs this first)
#   wayvnc-fit          watch wayvnc: first connect moves every workspace onto
#                       it, last disconnect moves them back to the real monitor
# :5901 (wayvnc-real.service) shows the real monitor and is never touched.
#
# 🔴 The screen is permanent on purpose. Creating it per connection meant
# switching wayvnc's output mid-session, and TigerVNC never applied the size
# change: scrollbars at the old 2560x1440 and a picture that stopped updating
# (2026-10-03). It sits at -2560x10000, touching no edge of the real monitor,
# so the mouse cannot reach it from the desk -- and to the LEFT, because the
# real monitor's `position = "auto"` puts it right of the rightmost screen
# (at 10000x0 the real monitor jumped to 12560x0, adjacent again), and it only ever holds the empty
# workspace "name:vnc", so Super+<n> at the desk never lands on it.
# 🔴 The name MUST start HEADLESS-: wayvnc decides "headless" by prefix
# (output_is_headless, src/output.c). Hyprland 0.56.2 never applies wayvnc's
# resize-to-window request, hence a fixed MODE.
# 🔴 Hyprland 0.56.2 configs are Lua: `hyprctl keyword` is refused, so the mode
# is set with `hyprctl eval` and dispatches are hl.dsp.* calls.
set -u

sock="${XDG_RUNTIME_DIR:?}/wayvncctl"
out=HEADLESS-VNC
park="name:vnc"
# The Mac's usable area is 2560x1049 (31 px menu bar, Dock auto-hidden), less
# TigerVNC's 28 px title bar. Full screen fits 2560x1080 exactly but takes the
# window controls away, and the viewer then grabs ⌘Q -- unusable (2026-10-03).
mode="${WAYVNC_FIT_MODE:-2560x1020@60}"

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  HYPRLAND_INSTANCE_SIGNATURE=$(ls -t "$XDG_RUNTIME_DIR/hypr/" | head -1)
  export HYPRLAND_INSTANCE_SIGNATURE
fi

dispatch() { hyprctl dispatch "$1" >/dev/null; }
exists() { hyprctl monitors all -j | jq -e --arg o "$out" 'any(.[]; .name == $o)' >/dev/null; }
real_output() { hyprctl monitors -j | jq -r --arg o "$out" '[.[] | select(.name != $o)][0].name'; }
active_ws() { hyprctl activeworkspace -j | jq -r '.name'; }
# Every normal workspace not already on $1 (specials have negative ids).
workspaces_off() {
  hyprctl workspaces -j | jq -r --arg m "$1" --arg p "${park#name:}" \
    '.[] | select(.id > 0 and .monitor != $m and .name != $p) | .name'
}
move_all_to() {
  local keep ws
  keep=$(active_ws)
  for ws in $(workspaces_off "$1"); do
    dispatch "hl.dsp.workspace.move({ workspace = \"name:$ws\", monitor = \"$1\" })"
  done
  [ "$keep" = "${park#name:}" ] || dispatch "hl.dsp.focus({ workspace = \"name:$keep\" })"
}

# Hyprland hands an empty monitor the next numbered workspace -- at creation,
# and again whenever its last workspace leaves. Park it on a named one instead,
# so the number is freed (an empty, inactive workspace is destroyed) and stays
# on the real monitor. Named workspaces get negative ids, so workspaces_off
# never moves the park.
park() {
  dispatch "hl.dsp.focus({ monitor = \"$out\" })"
  dispatch "hl.dsp.focus({ workspace = \"$park\" })"
  dispatch "hl.dsp.focus({ workspace = \"name:$1\" })"
}

ensure() {
  local i
  for i in $(seq 30); do hyprctl monitors >/dev/null 2>&1 && break; sleep 1; done
  exists && return 0
  local keep
  keep=$(active_ws)
  hyprctl output create headless "$out" >/dev/null
  hyprctl eval "hl.monitor({ output = \"$out\", mode = \"$mode\", position = \"-2560x10000\", scale = 1 })" >/dev/null
  # The output is not ready for focus dispatches the instant it is created.
  for i in $(seq 20); do
    hyprctl monitors -j | jq -e --arg o "$out" 'any(.[]; .name == $o and .width > 0)' >/dev/null && break
    sleep 0.2
  done
  sleep 0.5
  park "$keep"
  echo "created $out $mode"
}

if [ "${1:-}" = ensure ]; then ensure; exit; fi

ensure
back() { move_all_to "$(real_output)"; park "$(active_ws)"; }
back   # a crash mid-session can leave them on the virtual screen

wayvncctl -S "$sock" --wait --reconnect --json event-receive | while IFS= read -r evt; do
  count=$(jq -r '.params.connection_count // 0' <<<"$evt")
  case "$(jq -r '.method' <<<"$evt")" in
    client-connected)
      [ "$count" -eq 1 ] && move_all_to "$out" && echo "workspaces -> $out" ;;
    client-disconnected)
      [ "$count" -eq 0 ] && back && echo "workspaces -> $(real_output)" ;;
    wayvnc-shutdown) back ;;
  esac
done
