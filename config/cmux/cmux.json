  // Diagrammo slate — sidebar tint matched to dgmo/src/palettes/slate.ts.
  // Terminal colors come from the Ghostty themes in ~/.config/ghostty/themes/.
  // tintOpacity is intentionally absent so the value saved in Settings still wins.
  "sidebarAppearance": {
    "lightModeTintColor": "#5b6672",
    "darkModeTintColor": "#202833"
  },

  // The workspace colour picker shipped cmux's own 16 — Crimson, Magenta,
  // Indigo, Brown — which are the one surface here still speaking a palette
  // that is not ours. Replaced with the ten Diagrammo slate accents, the same
  // hexes the sidebar row states are painted from (dgmo/src/palettes/slate.ts,
  // light variant: mid-tone enough to read on either appearance). Listing
  // `colors` REPLACES the built-in set rather than adding to it, so anything
  // omitted here is gone from the picker — which is the point.
  "workspaceColors": {
    "colors": {
      "Blue": "#3b6ea5",
      "Steel": "#4f96c4",
      "Teal": "#3a9188",
      "Green": "#5b9357",
      "Yellow": "#c9a227",
      "Orange": "#cc7a33",
      "Red": "#c0504d",
      "Purple": "#7d5ba6",
      "Slate": "#5b6672",
      "Ink": "#1f2933"
    },
    "notificationBadgeColor": "#c0504d"
  },

  // Slate, and dimmer than the focused divider so the eye goes to the pane that
  // has focus rather than to every seam at once.
  "paneBorderColor": "#5b6672",
  "activePaneBorderColor": "#3b6ea5",

  // Nearly every workspace sits in ~/code/diagrammo, so the directory line says
  // the same thing on every row — off. branchLayout keeps git detail on one
  // line, including the directory if showBranchDirectory is turned back on.
  // The row colour now carries session state (yellow empty, green working, red
  // waiting on you, blue no Claude), so the wordy "Claude is waiting for your
  // input" line under each title says nothing the colour has not already said.
  // showPorts is off because the ports moved INTO the status pill, to the right
  // of the context bar (cmux-throbber.py reads them back out of
  // `cmux sidebar-state`). Same trade as the progress row: one line, not two.
  // Turning it back on shows every port twice — drop the ports() call in the
  // throbber if you prefer cmux's row, which is clickable and updates while the
  // session is idle.
  "sidebar": {
    "showBranchDirectory": false,
    "branchLayout": "inline",
    "stackBranchDirectory": false,
    "showNotificationMessage": false,
    "showPorts": false
  },

  // Reclaim the Metal renderer of off-screen terminals sooner. The saved
  // settings kept 12 warm renderers for 30s; upstream now defaults to 1 and 5s.
  // Non-destructive — the process and terminal state stay alive, only the GPU
  // surface is released and rebuilt when the tab is visited.
  "terminal": {
    "rendererRealization": {
      "enabled": true,
      "idleSeconds": 5,
      "maxWarmRenderers": 2
    }
  }
}
