#!/bin/bash
# ~/.local/bin/eagle-power-brightness
# Installed by install.sh next to this file. Run by eagle-power-brightness.service
# (systemd --user, graphical session).
#
# Sets the panel brightness AND the power-profiles-daemon profile when the
# power state CHANGES, and at session start:
#   battery            -> 33%, power-saver
#   AC, charging       -> 80%, balanced
#   AC, battery full   -> 100%, balanced
# Between changes it touches neither, so manual adjustment sticks.
# power-saver on battery: ppd sets intel_pstate EPP to "power" and the platform
# profile to low-power. Measured 2026-10-16 (eagle-health-audit): balanced on
# battery drew 38 W at 90 C with the fan idle. EPP "power" pins the cores at
# ~1.1 GHz, so eagle/epp lifts it to balance_power under power-saver (#13).
# Wakes on power_supply udev events, and polls every POLL seconds because
# acpi-sbs does not reliably emit an event on the Charging -> Full flip.
#
# Env overrides exist for tests only: EAGLE_PS_PATH EAGLE_SET EAGLE_PROFILE_SET EAGLE_ONCE EAGLE_SETTLE
set -u

ps_path=${EAGLE_PS_PATH:-/sys/class/power_supply}
poll=${EAGLE_POLL:-30}
settle=${EAGLE_SETTLE:-2}

set_brightness() {
  if [[ -n ${EAGLE_SET:-} ]]; then $EAGLE_SET "$1"; return; fi
  local dev
  dev=$(omarchy-hw-display) || return
  brightnessctl -q -d "$dev" set "$1%"
}

set_profile() {
  if [[ -n ${EAGLE_PROFILE_SET:-} ]]; then $EAGLE_PROFILE_SET "$1"; return; fi
  command -v powerprofilesctl >/dev/null || return 0
  powerprofilesctl set "$1" 2>/dev/null
}

# Prints battery | charging | full. A charger too weak for the load (the iPad
# one: adapter online, yet the battery reports Discharging) counts as battery,
# so the low-draw settings apply. "Not charging" is the charger covering the
# load with the battery at rest, and stays charging.
power_state() {
  local s ac=0 full=1 any_bat=0 draining=0
  for s in "$ps_path"/*; do
    [[ -r $s/type ]] || continue
    case $(<"$s/type") in
    Mains | USB) [[ $(cat "$s/online" 2>/dev/null) == 1 ]] && ac=1 ;;
    Battery)
      [[ $(cat "$s/present" 2>/dev/null) == 0 ]] && continue
      any_bat=1
      case $(cat "$s/status" 2>/dev/null) in
      Full) ;;
      Discharging) full=0; draining=1 ;;
      *) full=0 ;;
      esac
      ;;
    esac
  done
  if ((!ac || draining)); then echo battery
  elif ((any_bat && full)); then echo full
  else echo charging; fi
}

level() { case $1 in battery) echo 33 ;; charging) echo 80 ;; full) echo 100 ;; esac }
profile() { case $1 in battery) echo power-saver ;; *) echo balanced ;; esac }

last=""
apply() {
  local now
  now=$(power_state)
  [[ $now == "$last" ]] && return
  set_brightness "$(level "$now")"
  set_profile "$(profile "$now")"
  logger -t eagle-power-brightness "$last -> $now: $(level "$now")%, $(profile "$now")" 2>/dev/null
  last=$now
}

apply
[[ -n ${EAGLE_ONCE:-} ]] && exit 0

exec {ev}< <(exec udevadm monitor --udev --subsystem-match=power_supply)
while :; do
  if read -r -t "$poll" -u "$ev" _; then
    sleep "$settle" # let both supplies report before reading
    while read -r -t 0.2 -u "$ev" _; do :; done
  fi
  apply
done
