[Unit]
Description=Diagrammo ecosystem docs dev server (Astro, :4321)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/demian/code/diagrammo/diagrammo-ecosystem-docs
Environment=PATH=/home/demian/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
Environment=ASTRO_DEV_BACKGROUND=1
ExecStart=/home/demian/code/diagrammo/diagrammo-ecosystem-docs/node_modules/.bin/astro dev --port 4321 --host 127.0.0.1
# Astro exits 143 on SIGTERM, so without this a clean `systemctl stop`
# leaves the unit reading `failed` for good.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
