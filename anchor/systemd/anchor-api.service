[Unit]
Description=Diagrammo Cloud API worker (wrangler, :8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/demian/code/diagrammo/diagrammo-cloud/packages/cloud-api
Environment=PATH=/home/demian/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/demian/code/diagrammo/diagrammo-cloud/packages/cloud-api/node_modules/.bin/wrangler dev --port 8787 --ip 127.0.0.1
# wrangler exits 143 on SIGTERM, so without this a clean `systemctl stop`
# leaves the unit reading `failed` for good.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=default.target
