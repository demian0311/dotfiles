#!/usr/bin/env sh
# This repo is PUBLIC and now carries agent memory notes (#3). A note is written
# for an audience of one agent, which is exactly the frame of mind that leaks a
# credential -- so the scan is mechanical rather than remembered.
#
# Installed by claude/install.sh via core.hooksPath. Skip with --no-verify only
# if you have read what you are committing.
#
# WHAT IT DOES NOT CATCH, measured 2026-09-21: gitleaks matches credential
# FORMATS, not disclosure. A synthetic GitHub PAT is refused; a synthetic AWS
# access-key id alone is not (the rule wants the secret key with it), and AWS's
# documented AKIAIOSFODNN7EXAMPLE is allowlisted outright. Crucially, prose --
# "the restic passphrase lives in ~/.config/restic/password and nowhere else" --
# is invisible to it. That note was held back by reading it, not by this hook.
# Treat the scan as a floor, never as the review.
command -v gitleaks >/dev/null 2>&1 || {
  printf 'pre-commit: gitleaks not on PATH — commit allowed, NOTHING SCANNED\n' >&2
  exit 0
}
gitleaks protect --staged --redact -v || {
  printf '\npre-commit: gitleaks found something in the staged changes. This repo is public.\n' >&2
  exit 1
}
